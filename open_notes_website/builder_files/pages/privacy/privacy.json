 "head_html": "<style>\nhtml:root { font-family: -apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"Segoe UI\", Roboto, \"Helvetica Neue\", sans-serif; }\n.on-appstore .on-soon { display: none; }\n.on-appstore:hover .on-label, .on-appstore:focus .on-label { display: none; }\n.on-appstore:hover .on-soon, .on-appstore:focus .on-soon { display: inline; }\nhtml, body { margin: 0; background: var(--on-bg); }\na:focus-visible, .on-appstore:focus-visible { outline: 2px solid var(--on-accent); outline-offset: 3px; }\n@media (prefers-reduced-motion: reduce) { * { transition: none !important; } }\nfooter a, .on-legal a:not(.on-choices) { color: inherit; text-decoration: underline; text-underline-offset: 2px; }\n.on-legal ul { margin: 0; padding-left: 1.25em; }\n.on-legal li + li { margin-top: 10px; }\n.on-legal strong { color: var(--on-text); font-weight: 600; }\n.on-choices { display: inline-flex; align-items: center; min-height: 44px; padding: 0 22px; border-radius: 980px; border: 1px solid var(--on-border); color: var(--on-text); text-decoration: none; font-weight: 600; }\n</style>\n{% include \"open_notes_website/templates/includes/on_analytics.html\" %}",
